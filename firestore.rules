rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isMember(cid) { return signedIn() && exists(/databases/$(database)/documents/circles/$(cid)/members/$(request.auth.uid)); }
    function isLeader(cid) { return signedIn() && get(/databases/$(database)/documents/circles/$(cid)).data.leaderUid == request.auth.uid; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function otherOf(m) { return m[0] == request.auth.uid ? m[1] : m[0]; }
    function isPairMember(pid) { return signedIn() && get(/databases/$(database)/documents/buddies/$(pid)).data.members.hasAny([request.auth.uid]); }

    // Admins are added by hand in the Firebase console.
    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow write: if false;
    }

    // Private account: real name, email, which Circles you are in. Only you.
    match /users/{uid} {
      allow read, write: if isSelf(uid);
      // Habits, including private ones. Only you.
      match /habits/{hid} {
        allow read, write: if isSelf(uid);
      }
    }

    // Public profile inside the app: nickname and colour only.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.keys().hasOnly(['nickname', 'color', 'updatedAt', 'photo', 'profession', 'topBadge'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 120000))
        && (!('profession' in request.resource.data) || (request.resource.data.profession is string && request.resource.data.profession.size() <= 60));
      // An admin can remove a profile photo that breaks the Circle promise.
      allow update: if isAdmin() && onlyChanged(['photo']) && !('photo' in request.resource.data);
      allow delete: if false;
    }

    // Join codes. You can look up a code you already know, but nobody except admins can list them.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    match /circles/{cid} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (isLeader(cid) && onlyChanged(['goal', 'description', 'planId', 'planStart']));

      match /members/{uid} {
        allow read: if isMember(cid) || isAdmin();
        // You can only add yourself, only after agreeing to the promise, and only with this Circle's code.
        allow create: if isSelf(uid)
          && request.resource.data.promise == true
          && request.resource.data.code is string
          && exists(/databases/$(database)/documents/joinCodes/$(request.resource.data.code))
          && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.code)).data.cid == cid;
        allow update: if isSelf(uid) && request.resource.data.code == resource.data.code && request.resource.data.promise == true;
        allow delete: if isSelf(uid) || isLeader(cid) || isAdmin();
      }

      match /posts/{pid} {
        allow read: if isMember(cid) || isAdmin();
        allow create: if isMember(cid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.hidden == false
          && request.resource.data.cheers is map;
        allow update: if (isMember(cid) && (
              // The author edits their own post, but cannot unhide it.
              (resource.data.uid == request.auth.uid
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.hidden == resource.data.hidden
                && request.resource.data.cheers == resource.data.cheers)
              // Anyone in the Circle adds or removes only their own cheer.
              || (onlyChanged(['cheers'])
                && request.resource.data.cheers.diff(resource.data.cheers).affectedKeys().hasOnly([request.auth.uid]))
            ))
          // The Circle leader or an admin can hide or show a post.
          || ((isLeader(cid) || isAdmin()) && onlyChanged(['hidden']));
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      }

      match /nudges/{nid} {
        allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
        allow create: if isMember(cid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.kind in ['cheer', 'nudge']
          && exists(/databases/$(database)/documents/circles/$(cid)/members/$(request.resource.data.to));
        allow delete: if signedIn() && resource.data.to == request.auth.uid;
      }
    }

    // Requests to lead a Circle. You can only ask for yourself, and only an admin can approve or decline.
    match /circleRequests/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.days is int
        && request.resource.data.days >= 30;
      allow update: if isAdmin()
        || (isSelf(uid) && resource.data.status != 'approved'
            && request.resource.data.uid == uid && request.resource.data.status == 'pending'
            && request.resource.data.days is int && request.resource.data.days >= 30);
      allow delete: if (isSelf(uid) && resource.data.status != 'approved') || isAdmin();
    }

    // Personal friend invite links. Anyone who has the link can look it up.
    match /invites/{token} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Buddy requests from inside a Circle. Only the two people involved can see them.
    match /buddyReqs/{rid} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && rid == request.resource.data.to + '_' + request.auth.uid;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // A buddy pair only exists when the other person invited you (their link or their request) and you accepted.
    match /buddies/{pid} {
      allow read: if signedIn() && resource.data.members.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && (
          (request.resource.data.token is string
            && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.from == otherOf(request.resource.data.members))
          || exists(/databases/$(database)/documents/buddyReqs/$(request.auth.uid + '_' + otherOf(request.resource.data.members)))
        );
      // Each person can only change their own fields: shared habits, real name, activity, last read.
      allow update: if signedIn() && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members
        && onlyChanged(['s_' + request.auth.uid, 'n_' + request.auth.uid, 'p_' + request.auth.uid, 'j_' + request.auth.uid, 'a_' + request.auth.uid, 'r_' + request.auth.uid]);
      allow delete: if signedIn() && resource.data.members.hasAny([request.auth.uid]);

      match /messages/{mid} {
        allow read: if isPairMember(pid);
        allow create: if isPairMember(pid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.kind in ['text', 'cheer', 'nudge', 'reveal-ask'];
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // Tags such as Mentor and Certified Leader. Everyone can see them, only admins can give them.
    match /badges/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Reports go to the Circles team. Only admins can read them.
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
